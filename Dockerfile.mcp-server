# Dockerfile for MySQL MCP Server
FROM python@sha256:9a7765b36773a37061455b332f18e265e7f58f6fea9c419a550d2a8b0e9db834

# uvのバイナリをダイジェスト固定でコピー
COPY --from=ghcr.io/astral-sh/uv@sha256:1025398289b62de8269e70c45b91ffa37c373f38118d7da036fb8bb8efc85d97 /uv /usr/local/bin/uv

# 作業ディレクトリの設定
WORKDIR /app

# システム依存関係のインストール（git は uv sync の git ソース依存に必要）
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# プロジェクトファイルをコピー
COPY pyproject.toml uv.lock ./
COPY README.md ./
COPY mysql_mcp_demo/ ./mysql_mcp_demo/

# 依存関係のインストール
RUN uv sync --no-dev

# 実行ユーザーの作成
RUN useradd -m -u 1000 mcpuser && \
    chown -R mcpuser:mcpuser /app
USER mcpuser

# ログディレクトリの作成
RUN mkdir -p /app/logs

# ヘルスチェック
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD uv run python -c "import mysql.connector; print('OK')" || exit 1

# MCPサーバーの起動
CMD ["uv", "run", "mysql_mcp_server"]
